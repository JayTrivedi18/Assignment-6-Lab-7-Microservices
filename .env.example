# ═══════════════════════════════════════════════════════════════════
# CampusConnect — Lab 7 Environment Variables Example
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ─── API Gateway ────────────────────────────────────────────────────
GATEWAY_PORT=4000

# ─── Configuration-based Service Discovery ─────────────────────────
# Local Docker (default — uses Docker Compose DNS service names)
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Cloud deployment example (uncomment and fill in real URLs):
# USER_SERVICE_URL=https://your-user-service.cloud-platform.example.com
# PRODUCT_SERVICE_URL=https://your-product-service.cloud-platform.example.com
# ORDER_SERVICE_URL=https://your-order-service.cloud-platform.example.com

# ─── User Service ───────────────────────────────────────────────────
PORT=3001
# Local MongoDB (Docker Compose)
MONGODB_URI=mongodb://user-mongodb:27017/campusconnect_users
# MongoDB Atlas (cloud deployment — replace with real Atlas connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusconnect_users?retryWrites=true&w=majority

# ─── Product Service ─────────────────────────────────────────────────
# PORT=3002
# MONGODB_URI=mongodb://product-mongodb:27017/campusconnect_products
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusconnect_products?retryWrites=true&w=majority

# ─── Order Service ───────────────────────────────────────────────────
# PORT=3003
# MONGODB_URI=mongodb://order-mongodb:27017/campusconnect_orders
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusconnect_orders?retryWrites=true&w=majority

# ─── Security Notes ──────────────────────────────────────────────────
# - Never hard-code passwords, API keys, or secrets in source files
# - Use platform-specific secret management for cloud deployments
# - MongoDB Atlas passwords must be URL-encoded if they contain special characters
